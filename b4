#include <stdio.h>
#include <math.h>

int main() {
    int n;
    long tongSNT = 0;
    
    printf("Nhap vao so nguyen duong n: ");
    scanf("%d", &n);
    
    for (int i = 2; i <= n; i++) {
        int laSNT = 1;
        for (int j = 2; j <= sqrt(i); j++) {
            if (i % j == 0) {
                laSNT = 0;
                break;
            }
        }
        if (laSNT) {
            tongSNT += i;
        }
    }
    
    printf("Tong cac so nguyen tố tu 2 den %d la: %ld\n", n, tongSNT);
    return 0;
}
